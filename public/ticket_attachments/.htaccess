# Deny access to everything by default
<FilesMatch ".*">
    Require all denied
</FilesMatch>

# Allow only specific file types (images, pdf, video)
<FilesMatch "\.(jpe?g|png|gif|webp|bmp|svg|pdf|mp4|mov|avi|wmv|mpeg)$">
    Require all granted
</FilesMatch>

# Prevent script execution (commented out if causing issues)
# RemoveHandler .php .php5 .php7 .phtml .pl .py .jsp .asp .sh .cgi
# AddType text/plain .php .php5 .php7 .phtml .pl .py .jsp .asp .sh .cgi

# Disable directory listing
Options -Indexes
